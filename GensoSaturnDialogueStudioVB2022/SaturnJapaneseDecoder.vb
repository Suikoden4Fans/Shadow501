    Public Shared Function Decode(encodedHex As String) As String
        Dim bytes = DialogueEncoding.HexToBytes(encodedHex)
        Dim result As New StringBuilder()
        Dim at As Integer = 0
        While at < bytes.Length
            Dim code As Byte = bytes(at)
            If code = &HF AndAlso at = bytes.Length - 1 Then Exit While
            Dim key As String
            If code >= 1 AndAlso code <= 12 AndAlso at + 1 < bytes.Length Then
                key = code.ToString("X2") & bytes(at + 1).ToString("X2")
                at += 2
            Else
                key = code.ToString("X2")
                at += 1
            End If
            Dim glyph As String = Nothing
            If glyphs.TryGetValue(key, glyph) Then
                result.Append(glyph)
            ElseIf key.Length = 4 Then
                result.Append("[").Append(key.Substring(0, 2)).Append(" ").Append(key.Substring(2, 2)).Append("]")
            Else
                result.Append("[").Append(key).Append("]")
            End If
        End While
        Return result.ToString()
    End Function
