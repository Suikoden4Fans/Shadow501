    Public Shared Function IsRejected(filename As String, bank As Integer, group As Integer, message As Integer) As Boolean
        Return rejectedSlots.Contains(filename & "|" & bank.ToString() & "|" & group.ToString() & "|" & message.ToString())
    End Function

    Public Shared Function ExpectedRecordCount() As Integer
        Dim total As Integer = 0
        For Each row In layouts
            Dim columns = row.Split("|"c)
            total += Integer.Parse(columns(5))
        Next
        Return total - rejectedSlots.Count
    End Function

    Public Shared Function ForFile(filename As String, bytes As Byte()) As List(Of SaturnTableSpec)
        Dim expected As String = Nothing
        If Not fingerprints.TryGetValue(filename, expected) Then Return New List(Of SaturnTableSpec)()
        If bytes Is Nothing OrElse Not Convert.ToHexString(SHA256.HashData(bytes)).Equals(expected, StringComparison.OrdinalIgnoreCase) Then
            Return New List(Of SaturnTableSpec)()
        End If
        Dim result As New List(Of SaturnTableSpec)
        For Each row In layouts
            If Not row.StartsWith(filename & "|", StringComparison.OrdinalIgnoreCase) Then Continue For
            Dim fields = row.Split("|"c)
            result.Add(New SaturnTableSpec With {
                .FileName = fields(0), .Bank = Integer.Parse(fields(1)),
                .BankEnd = Integer.Parse(fields(2)),
                .Group = Integer.Parse(fields(3)),
                .Table = Integer.Parse(fields(4)),
                .Slots = Integer.Parse(fields(5))})
        Next
        Return result
    End Function
End Class
